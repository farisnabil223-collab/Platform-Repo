model Assessment {
  id              String                   @id @db.Uuid
  code            String                   @unique
  title           String
  type            String // EXAM, PRACTICE_EXAM, QUIZ, PLACEMENT, DIAGNOSTIC
  status          AssessmentWorkflowStatus @default(DRAFT)
  maxScore        Float                    @map("max_score")
  passingScore    Float                    @map("passing_score")
  durationSeconds Int                      @map("duration_seconds")
  settings        Json // Seed, randomization choices, review policies
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  deletedAt       DateTime?                @map("deleted_at")
  version         Int                      @default(1)
  courseId        String?                  @map("course_id") @db.Uuid
  course          Course?                  @relation(fields: [courseId], references: [id])

  questions                   AssessmentQuestion[]
  attempts                    AssessmentAttempt[]
  snapshots                   AssessmentSnapshot[]
  versions                    AssessmentVersion[]
  statistics                  AssessmentStatistics[]
  gradingPolicy               GradingPolicy?
  AssessmentVersionAggregate  AssessmentVersionAggregate?
  GradeEntry                  GradeEntry[]
  AssessmentAnalytics         AssessmentAnalytics[]
  AssessmentAnalyticsSnapshot AssessmentAnalyticsSnapshot[]

  @@index([status])
  @@map("assessments")
}

model AssessmentVersion {
  id           String   @id @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  versionNum   Int      @map("version_num")
  structure    Json
  createdAt    DateTime @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, versionNum])
  @@map("assessment_versions")
}

model AssessmentTemplate {
  id        String   @id @db.Uuid
  title     String
  blueprint Json // blueprint metadata topics & difficulty distributions
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("assessment_templates")
}

model AssessmentSnapshot {
  id           String   @id @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  snapshotData Json     @map("snapshot_data") // Complete immutable snapshot of questions, choices, points, order
  createdAt    DateTime @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_snapshots")
}

model AssessmentQuestion {
  assessmentId String @map("assessment_id") @db.Uuid
  questionId   String @map("question_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")
  pointsWeight Float  @default(1.0) @map("points_weight")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([assessmentId, questionId])
  @@map("assessment_questions")
}

model QuestionBank {
  id          String   @id @db.Uuid
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  questions Question[]

  @@map("question_banks")
}

model Question {
  id         String       @id @db.Uuid
  bankId     String?      @map("bank_id") @db.Uuid
  code       String       @unique
  type       QuestionType
  difficulty String // EASY, MEDIUM, HARD
  text       String
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")
  version    Int          @default(1)

  bank               QuestionBank?        @relation(fields: [bankId], references: [id])
  choices            QuestionChoice[]
  versions           QuestionVersion[]
  categories         QuestionCategory[]
  tags               QuestionTag[]
  skills             QuestionSkill[]
  topics             QuestionTopic[]
  assessments        AssessmentQuestion[]
  dependencies       QuestionDependency[] @relation("QuestionDeps")
  dependentQuestions QuestionDependency[] @relation("DependentDeps")
  QuestionSnapshot   QuestionSnapshot[]
  QuestionOption     QuestionOption[]

  @@map("questions")
}

model QuestionChoice {
  id         String  @id @db.Uuid
