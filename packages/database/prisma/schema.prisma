  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("grade_appeals")
}

model AssessmentStatistics {
  id                 String   @id @db.Uuid
  assessmentId       String   @map("assessment_id") @db.Uuid
  averageScore       Float    @map("average_score")
  medianScore        Float    @map("median_score")
  standardDeviation  Float    @map("standard_deviation")
  passRate           Float    @map("pass_rate")
  completionTimeAvg  Float    @map("completion_time_avg")
  questionDifficulty Json     @map("question_difficulty")
  calculatedAt       DateTime @default(now()) @map("calculated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_statistics")
}

