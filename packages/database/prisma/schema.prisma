model Product {
  id                String                @id @db.Uuid
  slug              String                @unique
  title             String
  description       String?
  thumbnail         String?
  price             Decimal               @db.Decimal(10, 2)
  currency          String                @default("USD")
  discountPrice     Decimal?              @map("discount_price") @db.Decimal(10, 2)
  status            ProductWorkflowStatus @default(DRAFT)
  visibility        ProductVisibility     @default(PUBLIC)
  type              ProductType
  targetType        String                @map("target_type")
  targetId          String                @map("target_id") @db.Uuid
  version           Int                   @default(1)
  publishedVersion  Int                   @default(1) @map("published_version")
  draftVersion      Int                   @default(1) @map("draft_version")
  isDraft           Boolean               @default(false) @map("is_draft")
  searchTitle       String                @map("search_title")
  searchDescription String?               @map("search_description")
  searchKeywords    String[]              @map("search_keywords")
  seoSlug           String                @map("seo_slug")
  searchWeight      Float                 @default(1.0) @map("search_weight")
  rankingScore      Float                 @default(0.0) @map("ranking_score")
  isActive          Boolean               @default(true) @map("is_active")
  publishedAt       DateTime              @default(now()) @map("published_at")
  unpublishedAt     DateTime?             @map("unpublished_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  deletedAt         DateTime?             @map("deleted_at")
  createdBy         String?               @map("created_by") @db.Uuid
  updatedBy         String?               @map("updated_by") @db.Uuid
  deletedBy         String?               @map("deleted_by") @db.Uuid

  cartItems      CartItem[]
  orderItems     OrderItem[]
  priceHistories ProductPriceHistory[]
  entitlements   Entitlement[]

  @@index([status, visibility, type])
  @@index([targetType, targetId])
  @@map("commerce_products")
}

model ProductPriceHistory {
