  negativeMarkingLimit Float  @default(0.0) @map("negative_marking_limit")
  rubricJson           Json?  @map("rubric_json")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("grading_policies")
}

model Rubric {
