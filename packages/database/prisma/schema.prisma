  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_skills")
}

model QuestionTopic {
  id         String @id @db.Uuid
  questionId String @map("question_id") @db.Uuid
  name       String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_topics")
}

model AssessmentAttempt {
  id             String                @id @db.Uuid
  assessmentId   String                @map("assessment_id") @db.Uuid
  studentId      String                @map("student_id") @db.Uuid
  status         AttemptWorkflowStatus @default(CREATED)
  attemptNum     Int                   @map("attempt_num")
  startedAt      DateTime              @default(now()) @map("started_at")
  submittedAt    DateTime?             @map("submitted_at")
  savedAnswers   Json?                 @map("saved_answers") // Keep as secondary auto-save cache
  tabSwitchCount Int                   @default(0) @map("tab_switch_count")
  isFlagged      Boolean               @default(false) @map("is_flagged")
  flaggedReason  String?               @map("flagged_reason")
  version        Int                   @default(1)

  assessment                   Assessment                     @relation(fields: [assessmentId], references: [id])
  student                      Student                        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers                      QuestionAnswer[]
  result                       AssessmentResult?
  reviews                      GradingReview[]
  AssessmentAttemptSnapshot    AssessmentAttemptSnapshot?
  QuestionSnapshot             QuestionSnapshot[]
  AssignmentSubmissionWorkflow AssignmentSubmissionWorkflow[]
  AssessmentReviewAudit        AssessmentReviewAudit[]
  ProctorSession               ProctorSession[]

  @@unique([studentId, assessmentId, attemptNum])
  @@map("assessment_attempts")
}

model QuestionAnswer {
  id             String   @id @db.Uuid
  attemptId      String   @map("attempt_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  textResponse   String?  @map("text_response")
  selectedChoice String[] @map("selected_choices")
  pointsAwarded  Float?   @map("points_awarded")
  isGraded       Boolean  @default(false) @map("is_graded")
  feedback       String?

  attempt     AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
