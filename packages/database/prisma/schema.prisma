  createdAt DateTime @default(now()) @map("created_at")

  section AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("assessment_rules")
}

model ExamCheckpoint {
  id          String   @id @db.Uuid
  attemptId   String   @map("attempt_id") @db.Uuid
  progress    Float
  answersJson Json     @map("answers_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("exam_checkpoints")
}

model ExamHeartbeat {
  id          String   @id @db.Uuid
  attemptId   String   @map("attempt_id") @db.Uuid
  deviceId    String   @map("device_id")
  heartbeatAt DateTime @default(now()) @map("heartbeat_at")

  @@map("exam_heartbeats")
}

model ExamLock {
  id           String   @id @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  lockedUntil  DateTime @map("locked_until")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("exam_locks")
}

model IntegrityIncident {
  id           String   @id @db.Uuid
  attemptId    String   @map("attempt_id") @db.Uuid
  incidentType String   @map("incident_type") // TAB_SWITCH, FULLSCREEN_EXIT, CAMERA_LOST, COPY, PASTE, DEVTOOLS, MULTIPLE_FACES
  severity     String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  metadata     Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("integrity_incidents")
}

model IntegrityRisk {
  id             String   @id @db.Uuid
  attemptId      String   @map("attempt_id") @db.Uuid
  score          Float
  recommendation String
  reviewed       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("integrity_risks")
}

model PlagiarismCheck {
  id              String   @id @db.Uuid
  submissionId    String   @map("submission_id") @db.Uuid
  provider        String
  similarityScore Float    @map("similarity_score")
  reportUrl       String   @map("report_url")
  references      Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("plagiarism_checks")
}

model CertificateRule {
  id                          String   @id @db.Uuid
  courseId                    String   @map("course_id") @db.Uuid
  minimumScore                Float    @map("minimum_score")
  minimumProgress             Float    @map("minimum_progress")
  requireAttendance           Boolean  @default(false) @map("require_attendance")
  requireAssignmentCompletion Boolean  @default(false) @map("require_assignment_completion")
  createdAt                   DateTime @default(now()) @map("created_at")

  @@map("certificate_rules")
}

model CertificateIssueQueue {
  id        String   @id @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  status    String   @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED
  createdAt DateTime @default(now()) @map("created_at")

  @@map("certificate_issue_queues")
}

model CertificateVerification {
  id               String   @id @db.Uuid
  certificateId    String   @map("certificate_id") @db.Uuid
  verificationCode String   @unique @map("verification_code")
  issuedAt         DateTime @default(now()) @map("issued_at")

  @@map("certificate_verifications")
}

model QuestionStatistics {
  id                  String   @id @db.Uuid
  questionId          String   @unique @map("question_id") @db.Uuid
  averageTime         Int      @map("average_time")
  correctRate         Float    @map("correct_rate")
  difficultyIndex     Float    @map("difficulty_index")
  discriminationIndex Float    @map("discrimination_index")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("question_statistics")
}

model IntegrityAnalytics {
  id                        String   @id @db.Uuid
  incidents                 Int
  cheatingScoreDistribution Json     @map("cheating_score_distribution")
  plagiarismAverage         Float    @map("plagiarism_average")
  createdAt                 DateTime @default(now()) @map("created_at")

  @@map("integrity_analytics")
}
