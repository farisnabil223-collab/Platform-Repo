datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRoleEnum {
  STUDENT
  TEACHER
  PARENT
  ADMIN
  SUPERADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HomeworkStatus {
  ASSIGNED
  SUBMITTED
  GRADED
  LATE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  EXPIRED
}

enum SubscriptionStatus {
  CREATED
  ACTIVE
  TRIALING
  PAUSED
  CANCELED
  INCOMPLETE
  EXPIRED
  GRACE_PERIOD
  RENEWED
  CANCELLED
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum AcademicYearStatus {
  DRAFT
  UPCOMING
  ACTIVE
  CLOSED
  ARCHIVED
}

enum CourseWorkflowStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  VIDEO
  PDF
  ARTICLE
  QUIZ
  ASSIGNMENT
  SCORM
  AUDIO
}

enum MediaStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AssessmentWorkflowStatus {
  DRAFT
  REVIEW
  SCHEDULED
  OPEN
  CLOSED
  GRADING
  PUBLISHED
  ARCHIVED
}

enum AttemptWorkflowStatus {
  CREATED
  STARTED
  IN_PROGRESS
  AUTO_SAVED
  SUBMITTED
  AUTO_GRADED
  MANUAL_REVIEW
  COMPLETED
  PUBLISHED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  ESSAY
  SHORT_ANSWER
  FILL_BLANK
  MATCHING
  ORDERING
  NUMERIC
  CODING
  FILE_UPLOAD
  DRAWING
  HOTSPOT
  CASE_STUDY
}

enum AppealWorkflowStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CLOSED
}

model User {
  id            String    @id @db.Uuid
  email         String    @unique
  phone         String?   @unique
  passwordHash  String    @map("password_hash")
  isActive      Boolean   @default(true) @map("is_active")
  isLocked      Boolean   @default(false) @map("is_locked")
  lockUntil     DateTime? @map("lock_until")
  emailVerified Boolean   @default(false) @map("email_verified")

  // Soft Delete, Auditing & Concurrency versioning
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  student                 Student?
  teacher                 Teacher?
  payments                Payment[]
  subscriptions           Subscription[]
  orders                  Order[]
  cart                    Cart?
  couponUsages            CouponUsage[]
  entitlements            Entitlement[]
  paymentIntents          PaymentIntent[]
  paymentMethods          PaymentMethod[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  userRoles               UserRole[]
  refreshTokens           RefreshToken[]
  sessions                Session[]
  devices                 Device[]
  otpCodes                OtpCode[]
  emailVerifications      EmailVerification[]
  passwordHistories       PasswordHistory[]
  loginAttempts           LoginAttempt[]
  guardian                Guardian?
  PlayerSession           PlayerSession[]
  LearningPathEnrollment  LearningPathEnrollment[]
  LearningTimelineEvent   LearningTimelineEvent[]
  LessonCompletion        LessonCompletion[]
  StudentBookmark         StudentBookmark[]
  StudentNote             StudentNote[]
  LearningAnalytics       LearningAnalytics[]
  CertificateEligibility  CertificateEligibility[]
  RecommendationCandidate RecommendationCandidate[]
  LearningGoal            LearningGoal?
  GamificationProfile     GamificationProfile?
  LessonDiscussion        LessonDiscussion[]
  AuthoringTransaction    AuthoringTransaction[]
  EditingLock             EditingLock[]
  ReviewComment           ReviewComment[]
  EditorialTask           EditorialTask[]
  AuthoringSession        AuthoringSession[]
  AuthorActivityLog       AuthorActivityLog[]
  DepartmentMembership    DepartmentMembership[]
  BranchMembership        BranchMembership[]
  Parent                  Parent?
  StudentCaseTask         StudentCaseTask[]
  MeetingParticipant      MeetingParticipant[]
  MeetingNote             MeetingNote[]
  MeetingAction           MeetingAction[]
  MobileDevice            MobileDevice[]
  SyncSession             SyncSession[]
  MobilePreference        MobilePreference?
  PushNotification        PushNotification[]
  ExperimentGroup         ExperimentGroup[]
  EventParticipant        EventParticipant[]
  LiveAttendance          LiveAttendance[]
  UserPresence            UserPresence?
  ActiveConnection        ActiveConnection[]
  PresenceSession         PresenceSession[]
  UserActivity            UserActivity?
  NotificationHistory     NotificationHistory[]
  SearchQueryHistory      SearchQueryHistory[]
  DataDeletionRequest     DataDeletionRequest[]

  @@map("users")
}

model Role {
  id          String   @id @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  version     Int      @default(1)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  version     Int      @default(1)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Session {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tokenHash    String   @unique @map("token_hash")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  isExpired    Boolean  @default(false) @map("is_expired")
  expiresAt    DateTime @map("expires_at")
  lastActivity DateTime @default(now()) @map("last_activity")
  createdAt    DateTime @default(now()) @map("created_at")
  version      Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Device {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  deviceHash   String   @map("device_hash")
  name         String?
  browser      String?
  os           String?
  ipAddress    String?  @map("ip_address")
  lastActivity DateTime @default(now()) @map("last_activity")
  isTrusted    Boolean  @default(false) @map("is_trusted")
  createdAt    DateTime @default(now()) @map("created_at")
  version      Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@map("devices")
}

model OtpCode {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  codeHash     String   @map("code_hash")
  purpose      String
  attempts     Int      @default(0)
  attemptLimit Int      @default(3) @map("attempt_limit")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model EmailVerification {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordHistory {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_histories")
}

model LoginAttempt {
  id        String   @id @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_attempts")
}

model RevokedToken {
  jti       String   @id
  revokedAt DateTime @default(now()) @map("revoked_at")
  expiresAt DateTime @map("expires_at")

  @@map("revoked_tokens")
}

model Classroom {
  id        String    @id @db.Uuid
  name      String
  code      String    @unique
  capacity  Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  sections Section[]

  @@map("classrooms")
}

model Grade {
  id          String    @id @db.Uuid
  level       String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  version     Int       @default(1)

  students Student[]
  subjects Subject[]
  sections Section[]

  @@map("grades")
}

model Section {
  id          String    @id @db.Uuid
  name        String
  code        String    @unique
  gradeId     String    @map("grade_id") @db.Uuid
  classroomId String    @map("classroom_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  version     Int       @default(1)

  grade       Grade               @relation(fields: [gradeId], references: [id])
  classroom   Classroom           @relation(fields: [classroomId], references: [id])
  enrollments StudentEnrollment[]

  @@map("sections")
}

model Subject {
  id          String    @id @db.Uuid
  code        String    @unique
  name        String
  description String?
  creditHours Int       @default(3) @map("credit_hours")
  weeklyHours Int       @default(4) @map("weekly_hours")
  isElective  Boolean   @default(false) @map("is_elective")
  isActive    Boolean   @default(true) @map("is_active")
  gradeId     String    @map("grade_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  version     Int       @default(1)

  grade    Grade            @relation(fields: [gradeId], references: [id])
  teachers TeacherSubject[]

  @@map("subjects")
}

model AcademicYear {
  id        String             @id @db.Uuid
  name      String             @unique
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")
  status    AcademicYearStatus @default(DRAFT)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  deletedAt DateTime?          @map("deleted_at")
  version   Int                @default(1)

  terms       AcademicTerm[]
  enrollments StudentEnrollment[]

  @@map("academic_years")
}

model AcademicTerm {
  id             String    @id @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  sortOrder      Int       @default(1) @map("sort_order")
  isActive       Boolean   @default(false) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  version        Int       @default(1)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@map("academic_terms")
}

model Student {
  id               String  @id @db.Uuid
  userId           String  @unique @map("user_id") @db.Uuid
  studentCode      String  @unique @map("student_code")
  gradeId          String? @map("grade_id") @db.Uuid
  status           String  @default("ACTIVE")
  academicMetadata Json    @default("{}") @map("academic_metadata")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade                    Grade?                     @relation(fields: [gradeId], references: [id])
  submissions              HomeworkSubmission[]
  examScores               ExamSubmission[]
  enrollments              StudentEnrollment[]
  guardians                StudentGuardian[]
  notes                    Note[]
  lessonProgresses         LessonProgress[]
  watchHistories           WatchHistory[]
  bookmarks                Bookmark[]
  Gradebook                Gradebook[]
  AssessmentAttempt        AssessmentAttempt[]
  GradeAppeal              GradeAppeal[]
  ParentStudent            ParentStudent[]
  StudentCase              StudentCase[]
  StudentSuccessTimeline   StudentSuccessTimeline[]
  StudentSuccessFactor     StudentSuccessFactor[]
  StudentRiskHistory       StudentRiskHistory[]
  StudentAnalyticsSnapshot StudentAnalyticsSnapshot[]
  StudentRecommendation    StudentRecommendation[]
  StudentAchievement       StudentAchievement[]
  AcademicGoal             AcademicGoal[]
  ProgressReport           ProgressReport[]
  AttendanceSummary        AttendanceSummary[]
  AttendanceAlert          AttendanceAlert[]
  AiChatSession            AiChatSession[]

  @@map("student_profiles")
}

model Teacher {
  id                 String   @id @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  teacherCode        String   @unique @map("teacher_code")
  bio                String?
  specialties        String[]
  employmentMetadata Json     @default("{}") @map("employment_metadata")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  user                        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses                     Course[]
  subjects                    TeacherSubject[]
  InstructorWorkspace         InstructorWorkspace[]
  InstructorAnalyticsSnapshot InstructorAnalyticsSnapshot[]

  @@map("teacher_profiles")
}

model TeacherSubject {
  teacherId String @map("teacher_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

model StudentEnrollment {
  id               String    @id @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  academicYearId   String    @map("academic_year_id") @db.Uuid
  sectionId        String?   @map("section_id") @db.Uuid
  enrollmentNumber String    @unique @map("enrollment_number")
  status           String    @default("ENROLLED")
  enrolledAt       DateTime  @default(now()) @map("enrolled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  version          Int       @default(1)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section      Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@map("student_enrollments")
}

model Guardian {
  id        String    @id @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  relation  String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentGuardian[]

  @@map("guardian_profiles")
}

model StudentGuardian {
  studentId  String @map("student_id") @db.Uuid
  guardianId String @map("guardian_id") @db.Uuid

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model Course {
  id               String               @id @db.Uuid
  code             String               @unique // VO CourseCode
  slug             String               @unique // VO CourseSlug
  title            String
  description      String?
  status           CourseWorkflowStatus @default(DRAFT)
  teacherId        String               @map("teacher_id") @db.Uuid
  currentVersionId String?              @map("current_version_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  createdBy        String?              @map("created_by") @db.Uuid
  updatedBy        String?              @map("updated_by") @db.Uuid
  version          Int                  @default(1)

  teacher                 Teacher                   @relation(fields: [teacherId], references: [id])
  modules                 Module[]
  catalogInfo             CatalogCourse?
  versions                CourseVersion[]
  tags                    CourseTag[]
  skills                  CourseSkill[]
  Exam                    Exam[]
  reviews                 CourseReview[]
  bundleCourses           BundleCourse[]
  CourseSection           CourseSection[]
  LearningPathItem        LearningPathItem[]
  CertificateEligibility  CertificateEligibility[]
  RecommendationCandidate RecommendationCandidate[]
  Gradebook               Gradebook[]
  Assessment              Assessment[]
  AuthoringTransaction    AuthoringTransaction[]
  TranslationProject      TranslationProject[]
  PublishingWorkflow      PublishingWorkflow[]
  PublishingSchedule      PublishingSchedule[]
  ContentReview           ContentReview[]
  EditorialTask           EditorialTask[]
  AuthoringSession        AuthoringSession[]
  CoursePreviewSession    CoursePreviewSession[]
  CourseAnalyticsSnapshot CourseAnalyticsSnapshot[]
  LiveSession             LiveSession[]

  @@map("courses")
}

model CourseVersion {
  id        String   @id @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  semver    String // e.g. 1.0.0 (VO VersionNumber)
  structure Json // Frozen snapshot of modules, lessons and contents metadata
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses         CourseProgress[]
  SectionVersion     SectionVersion[]
  ContentReleaseItem ContentReleaseItem[]

  @@map("course_versions")
}

model Module {
  id        String    @id @db.Uuid
  courseId  String    @map("course_id") @db.Uuid
  code      String    @unique // VO ModuleCode
  title     String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id                String    @id @db.Uuid
  moduleId          String    @map("module_id") @db.Uuid
  code              String    @unique // VO LessonCode
  title             String
  sortOrder         Int       @default(0) @map("sort_order")
  displayOrder      Int       @default(0) @map("display_order")
  estimatedDuration Int       @default(0) @map("estimated_duration")
  isLocked          Boolean   @default(false) @map("is_locked")
  unlockCondition   Json?     @map("unlock_condition")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  module                  Module                   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contents                LearningContent[]
  Homework                Homework[]
  CourseSection           CourseSection?           @relation(fields: [courseSectionId], references: [id])
  courseSectionId         String?                  @db.Uuid
  LessonContent           LessonContent[]
  ContentVersionAggregate ContentVersionAggregate?
  PlayerSession           PlayerSession[]
  LearningTimelineEvent   LearningTimelineEvent[]
  LessonCompletion        LessonCompletion[]
  StudentBookmark         StudentBookmark[]
  StudentNote             StudentNote[]
  LessonTranscript        LessonTranscript[]
  LessonResource          LessonResource[]
  LearningAnalytics       LearningAnalytics[]
  LessonDiscussion        LessonDiscussion[]
  LessonProgress          LessonProgress[]
  LessonVersionReference  LessonVersionReference[]

  @@map("lessons")
}

model LearningContent {
  id               String      @id @db.Uuid
  lessonId         String      @map("lesson_id") @db.Uuid
  contentType      ContentType @map("content_type")
  title            String
  sortOrder        Int         @default(0) @map("sort_order")
  currentVersionId String?     @map("current_version_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  lesson       Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  versions     LearningContentVersion[]
  quizId       String?                  @map("quiz_id") @db.Uuid // Linked Quiz aggregate ref
  assignmentId String?                  @map("assignment_id") @db.Uuid // Linked Assignment aggregate ref

  @@map("learning_contents")
}

model LearningContentVersion {
  id         String   @id @db.Uuid
  contentId  String   @map("content_id") @db.Uuid
  versionNum Int      @map("version_num")
  payload    Json // Specific metadata (streaming url, pdf link, doc text)
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  content LearningContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, versionNum])
  @@map("learning_content_versions")
}

model MediaAsset {
  id              String      @id @db.Uuid
  title           String
  storageProvider String      @map("storage_provider") // S3, R2, CLOUDFLARE_STREAM
  storagePath     String      @map("storage_path")
  streamingUrl    String?     @map("streaming_url")
  subtitles       Json? // Lang-to-path mappings
  status          MediaStatus @default(UPLOADED)
  errorMessage    String?     @map("error_message")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  watchHistories WatchHistory[]
  jobs           MediaProcessingJob[]
  MediaVersion   MediaVersion[]
  MediaVariant   MediaVariant[]
  MediaThumbnail MediaThumbnail[]
  MediaUsage     MediaUsage[]
  MediaFolder    MediaFolder?         @relation(fields: [mediaFolderId], references: [id])
  mediaFolderId  String?              @db.Uuid
  MediaTag       MediaTag[]

  @@map("media_assets")
}

model MediaProcessingJob {
  id           String      @id @db.Uuid
  mediaAssetId String      @map("media_asset_id") @db.Uuid
  queueName    String      @map("queue_name")
  retryCount   Int         @default(0) @map("retry_count")
  status       MediaStatus @default(QUEUED)
  errorMessage String?     @map("error_message")
  createdAt    DateTime    @default(now()) @map("created_at")
